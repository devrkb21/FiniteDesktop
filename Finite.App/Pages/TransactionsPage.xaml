<Page x:Class="Finite.App.Pages.TransactionsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Transactions" FontSize="28" FontWeight="SemiBold" />

        <ui:Card Grid.Row="1" Margin="0,12,0,12" Padding="16">
            <StackPanel>
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding TransactionTypes}"
                              SelectedItem="{Binding SelectedType}" Width="120" Margin="0,0,8,8" />
                    <ui:TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Amount ৳" Width="130" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding AccountOptions}"
                              SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="Name" Width="190" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name" Width="190" Margin="0,0,8,8" />
                    <DatePicker SelectedDate="{Binding Date}" Width="150" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel>
                    <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Description (optional)" Width="420" Margin="0,0,8,8" />
                    <ui:Button Content="Add Transaction" Appearance="Primary"
                               Command="{Binding AddCommand}" Margin="0,0,12,8" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <ui:ListView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="Single">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}" />
                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding Account.Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Category.Name}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat='৳ {0:N2}'}"
                                   HorizontalAlignment="Right" FontWeight="SemiBold" />
                        <ui:Button Grid.Column="6" Content="Delete" Appearance="Danger" Margin="8,0,0,0"
                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                   CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>
