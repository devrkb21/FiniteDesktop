<Page x:Class="Finite.App.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Finite.App.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{Binding LastRun}" FontSize="12" Foreground="#4ADE80" Margin="0,0,0,12" />

            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,16">
                <ui:Card Margin="0,0,8,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="NET WORTH" FontSize="10" Opacity="0.7" />
                        <TextBlock Text="{Binding NetWorth}" FontSize="22" FontWeight="Bold" />
                        <TextBlock FontSize="11" Opacity="0.7">
                            <Run Text="Assets: " /><Run Text="{Binding Assets}" />
                            <Run Text="  ·  Liab: " /><Run Text="{Binding Liabilities}" />
                        </TextBlock>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0,8,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH IN" FontSize="10" Opacity="0.7" />
                        <TextBlock Text="{Binding MonthlyIncome}" FontSize="22" FontWeight="Bold" Foreground="#4ADE80" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="THIS MONTH OUT" FontSize="10" Opacity="0.7" />
                        <TextBlock Text="{Binding MonthlyExpense}" FontSize="22" FontWeight="Bold" Foreground="#F87171" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,8,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CASH FLOW (MONTH)" FontSize="10" Opacity="0.7" />
                        <TextBlock Text="{Binding MonthlyFlow}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0,8,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="DAILY AVG SPEND" FontSize="10" Opacity="0.7" />
                        <TextBlock Text="{Binding DailyAverage}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="QUICK LINKS" FontSize="10" Opacity="0.7" />
                        <TextBlock Text="Use the sidebar: Transactions, Accounts, Transfers, Budgets, Debts, Goals, Recurring, Analytics, Calendar." FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <ui:Card Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Balance Trend — Last 30 Days" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <controls:SimpleLineChart Height="200" Values="{Binding TrendValues}" Labels="{Binding TrendLabels}" StrokeColor="#10B981" />
                </StackPanel>
            </ui:Card>

            <UniformGrid Columns="2" Margin="0,0,0,16">
                <ui:Card Margin="0,0,8,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Budget Alerts" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="All budgets within limits." FontSize="12" Opacity="0.6"
                                   Visibility="{Binding HasNoAlerts, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding BudgetAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{Binding Color}" Margin="0,3" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="8,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Savings Goals" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding GoalProgress}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ColoredProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                     Foreground="{Binding Color}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11" Margin="10,0,0,0" Opacity="0.85" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <TextBlock Text="Recent Transactions" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8" />
            <ui:ListView ItemsSource="{Binding RecentTransactions}" SelectionMode="Single">
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Date, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Description}" TextTrimming="CharacterEllipsis" FontSize="12" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontWeight="SemiBold"
                                       Text="{Binding Amount, StringFormat='৳ {0:N2}'}" />
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
