<Page x:Class="Finite.App.Pages.BudgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:Finite.App.Controls"
      mc:Ignorable="d"
      Loaded="OnLoaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Budgets" FontSize="28" FontWeight="SemiBold" />

        <ui:Card Grid.Row="1" Margin="0,12,0,12" Padding="16">
            <WrapPanel>
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Budget name (optional)" Width="180" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Width="170" Margin="0,0,8,8" />
                <ui:TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Limit ৳" Width="120" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                          Width="110" Margin="0,0,8,8" />
                <ui:Button Content="Add Budget" Appearance="Primary" Command="{Binding AddCommand}" Margin="0,0,12,8" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </WrapPanel>
        </ui:Card>

        <ui:ListView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="Single">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CategoryName, StringFormat=' · {0}'}" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <controls:ColoredProgressBar Minimum="0" Maximum="100" Value="{Binding PercentUsed}"
                                                Margin="0,6,0,0" Foreground="{Binding ProgressColor}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding SpentText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Opacity="0.8" />
                        <TextBlock Grid.Column="3" Text="{Binding AmountText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Opacity="0.8" />
                        <TextBlock Grid.Column="4" Text="{Binding PercentText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="{Binding ProgressColor}" />
                        <ui:Button Grid.Column="5" Content="Delete" Appearance="Danger" Margin="8,0,0,0"
                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                   CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>
