<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Finite.Core\Finite.Core.csproj" />
    <ProjectReference Include="..\Finite.Data\Finite.Data.csproj" />
    <ProjectReference Include="..\Finite.Services\Finite.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <AssemblyTitle>Finite Desktop</AssemblyTitle>
    <Product>Finite — Personal Finance</Product>
    <Description>Local-first personal finance tracker for Windows</Description>
    <Company>Finite</Company>
    <ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
